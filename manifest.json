{
  "manifest_version": 3,
  "name": "Unhook for Gemini",
  "version": "1.0",
  "description": "Remove distracting elements from Gemini.",
  "icons": {
    "16": "images/icon16.png",
    "32": "images/icon32.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Unhook for Gemini",
    "default_icon": {
      "16": "images/icon16.png",
      "32": "images/icon32.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["*://*.gemini.google.com/*"],
      "js": ["content.js"]
    }
  ]
}
